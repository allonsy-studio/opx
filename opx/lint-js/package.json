{
	"$schema": "https://www.schemastore.org/package.json",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"name": "@allons-y/opx-lint-js",
	"version": "0.1.0",
	"description": "opx detector + runner for JavaScript/TypeScript. Bundles ESLint, @stylistic/eslint-plugin, and typescript-eslint.",
	"license": "MPL-2.0",
	"author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
	"homepage": "https://github.com/allonsy-studio/opx#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allonsy-studio/opx.git",
		"directory": "opx/lint-js"
	},
	"bugs": {
		"url": "https://github.com/allonsy-studio/opx/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./bin/index.js",
			"types": "./bin/index.d.ts"
		},
		"./eslint.config.js": "./eslint.config.js"
	},
	"main": "./bin/index.js",
	"files": [
		"bin/",
		"CHANGELOG.md",
		"README.md",
		"package.json",
		"LICENSE",
		"eslint.config.js"
	],
	"scripts": {
		"build": "yarn g:build && yarn g:dts",
		"clean": "yarn g:clean",
		"coverage": "yarn g:coverage",
		"test": "yarn g:test",
		"typecheck": "yarn g:typecheck"
	},
	"types": "./bin/index.d.ts",
	"dependencies": {
		"@allons-y/opx": "^0.1.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.11.0",
		"globals": "^17.13.0",
		"typescript-eslint": "^8.71.0"
	},
	"devDependencies": {
		"eslint-plugin-jest": "^29.16.6"
	},
	"peerDependencies": {
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"keywords": [
		"opx",
		"eslint",
		"linter",
		"javascript",
		"typescript"
	],
	"engines": {
		"node": ">=24"
	},
	"opx": {
		"entry": "src/index.ts",
		"outfile": "bin/index.js"
	}
}
