{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@allons-y/opx-docs",
	"version": "0.0.0",
	"description": "Documentation site for the opx toolkit.",
	"license": "MPL-2.0",
	"author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
	"homepage": "https://github.com/allonsy-studio/opx#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allonsy-studio/opx.git",
		"directory": "opx/docs"
	},
	"bugs": {
		"url": "https://github.com/allonsy-studio/opx/issues"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"build": "run-s typedoc eleventy:build pagefind",
		"dev": "run-s typedoc eleventy:dev",
		"eleventy:build": "eleventy",
		"eleventy:dev": "eleventy --serve",
		"typedoc": "typedoc",
		"pagefind": "pagefind --site _site",
		"clean": "rm -rf _site src/api"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-navigation": "^0.3.5",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"markdown-it": "^14.3.2",
		"markdown-it-anchor": "^9.2.1",
		"npm-run-all2": "^9.0.3",
		"pagefind": "^1.5.2",
		"typedoc": "^0.28.20",
		"typedoc-plugin-frontmatter": "^1.3.2",
		"typedoc-plugin-markdown": "^4.13.1"
	},
	"engines": {
		"node": ">=24"
	}
}
