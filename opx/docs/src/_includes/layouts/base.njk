<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}</title>
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content="{{ description or site.tagline }}" />
		<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 32 32%27%3E%3Crect width=%2732%27 height=%2732%27 rx=%277%27 fill=%27%232346d4%27/%3E%3Ctext x=%2716%27 y=%2722%27 font-family=%27monospace%27 font-size=%2714%27 font-weight=%27700%27 fill=%27white%27 text-anchor=%27middle%27%3Eopx%3C/text%3E%3C/svg%3E" />
		<link rel="stylesheet" href="/assets/css/main.css" />
		<script src="https://kit.fontawesome.com/42e99b4632.js" crossorigin="anonymous"></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<a class="studio-banner" href="{{ site.studio }}">
			<img src="/assets/img/oss-banner.svg" alt="Brought to you by Allons-y Studio" width="1600" height="64" />
		</a>
		<header class="site-header">
			<a class="site-title" href="/">{{ site.title }}</a>
			<p class="site-tagline">{{ site.tagline }}</p>
			<a class="site-link" href="{{ site.repo }}"><span class="fa-brands fa-github" aria-hidden="true"></span>GitHub</a>
			<a class="site-link" href="{{ site.npm }}"><span class="fa-brands fa-npm" aria-hidden="true"></span>npm</a>
		</header>
		{{ content | safe }}
		<footer class="site-footer">
			<div class="site-footer-brand">
				<p class="site-footer-title">{{ site.title }}</p>
				<p>{{ site.tagline }}.</p>
				<p class="site-footer-meta"><a href="{{ site.repo }}/blob/main/LICENSE">Licensed under MPL-2.0</a></p>
			</div>
			<div>
				<p class="site-footer-title">Project</p>
				<ul>
					<li><a href="{{ site.repo }}"><span class="fa-brands fa-github" aria-hidden="true"></span>GitHub</a></li>
					<li><a href="{{ site.npm }}"><span class="fa-brands fa-npm" aria-hidden="true"></span>npm</a></li>
				</ul>
			</div>
			<div>
				<p class="site-footer-title">Help</p>
				<ul>
					<li><a href="{{ site.repo }}/issues">Report an issue</a></li>
					<li><a href="{{ site.repo }}/blob/main/.github/CONTRIBUTING.md">Contributing guide</a></li>
				</ul>
			</div>
			<div class="site-footer-studio">
				<a href="{{ site.studio }}">
					<picture>
						<source media="(prefers-color-scheme: dark)" srcset="/assets/img/oss-footer-dark.png" />
						<img src="/assets/img/oss-footer-light.png" alt="Brought to you by Allons-y Studio" width="220" height="103" />
					</picture>
				</a>
			</div>
		</footer>
	</body>
</html>
