{
	"$schema": "https://www.schemastore.org/package.json",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"name": "@allons-y/opx-lint-ts",
	"version": "0.1.0-beta.0",
	"description": "opx detector + runner for TypeScript. Bundles ESLint, @stylistic/eslint-plugin, and typescript-eslint.",
	"license": "Apache-2.0",
	"author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
	"homepage": "https://github.com/allonsy-studio/opx#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allonsy-studio/opx.git",
		"directory": "opx/lint-ts"
	},
	"bugs": {
		"url": "https://github.com/allonsy-studio/opx/issues"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./bin/index.d.ts",
			"import": "./bin/index.js"
		},
		"./eslint.config.js": "./eslint.config.js"
	},
	"main": "./bin/index.js",
	"files": [
		"bin/",
		"CHANGELOG.md",
		"README.md",
		"package.json",
		"LICENSE",
		"eslint.config.js"
	],
	"scripts": {
		"build": "yarn g:build && yarn g:dts",
		"prepack": "yarn g:inject",
		"clean": "yarn g:clean",
		"coverage": "yarn g:coverage",
		"test": "yarn g:test",
		"typecheck": "yarn g:typecheck"
	},
	"types": "./bin/index.d.ts",
	"dependencies": {
		"@allons-y/opx": "^0.1.0-beta.1",
		"@eslint/compat": "2.1.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"eslint": "10.11.0",
		"typescript-eslint": "8.71.0"
	},
	"devDependencies": {
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"keywords": [
		"opx",
		"eslint",
		"linter",
		"typescript"
	],
	"engines": {
		"node": ">=24"
	}
}
