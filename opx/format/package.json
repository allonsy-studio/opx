{
  "$schema": "https://www.schemastore.org/package.json",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "name": "@allons-y/opx-format",
  "version": "0.0.0",
  "description": "opx detector + runner for formatting. Bundles Prettier.",
  "license": "Apache-2.0",
  "author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
  "homepage": "https://github.com/allonsy-studio/opx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allonsy-studio/opx.git",
    "directory": "opx/format"
  },
  "bugs": {
    "url": "https://github.com/allonsy-studio/opx/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./bin/index.d.ts",
      "import": "./bin/index.js"
    },
    "./prettier": {
      "types": "./prettier.config.d.ts",
      "import": "./prettier.config.js"
    }
  },
  "main": "./bin/index.js",
  "files": [
    "bin/",
    "CHANGELOG.md",
    "README.md",
    "package.json",
    "LICENSE",
    "prettier.config.js",
    "prettier.config.d.ts"
  ],
  "scripts": {
    "build": "yarn g:build && yarn g:dts",
    "prepack": "yarn g:inject",
    "clean": "yarn g:clean",
    "coverage": "yarn g:coverage",
    "test": "yarn g:test",
    "typecheck": "yarn g:typecheck"
  },
  "types": "./bin/index.d.ts",
  "dependencies": {
    "@allons-y/opx": "^0.1.0",
    "prettier": "3.10.1"
  },
  "keywords": [
    "opx",
    "prettier",
    "formatter"
  ],
  "engines": {
    "node": ">=24"
  }
}
