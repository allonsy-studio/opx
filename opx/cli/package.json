{
	"$schema": "https://www.schemastore.org/package.json",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"name": "@allons-y/opx-cli",
	"version": "0.1.0",
	"description": "opx CLI (bin: opx) — scans the committed tree, suggests language tooling, drives the opx engine.",
	"license": "MPL-2.0",
	"author": "Cassondra Roberts <castastrophe@users.noreply.github.com> (https://allons-y.studio)",
	"homepage": "https://github.com/allonsy-studio/opx#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allonsy-studio/opx.git",
		"directory": "opx/cli"
	},
	"bugs": {
		"url": "https://github.com/allonsy-studio/opx/issues"
	},
	"type": "module",
	"bin": {
		"opx": "./bin/index.js"
	},
	"exports": {
		".": {
			"types": "./bin/index.d.ts",
			"import": "./bin/index.js"
		}
	},
	"main": "./bin/index.js",
	"types": "./bin/index.d.ts",
	"files": [
		"bin/",
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"package.json"
	],
	"scripts": {
		"build": "yarn g:build && yarn g:dts",
		"test": "yarn g:test",
		"coverage": "yarn g:coverage",
		"typecheck": "yarn g:typecheck",
		"clean": "yarn g:clean"
	},
	"dependencies": {
		"@allons-y/opx": "^0.1.0",
		"@clack/prompts": "^1.6.0",
		"commander": "^14.0.3"
	},
	"keywords": [
		"opx",
		"cli",
		"linter",
		"toolkit"
	],
	"engines": {
		"node": ">=24"
	},
	"opx": {
		"entry": "src/index.ts",
		"outfile": "bin/index.js"
	}
}
